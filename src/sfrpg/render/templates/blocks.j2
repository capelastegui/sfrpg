{#- HTML blocks for game data. Class names match css/sfrpg.css. -#}

{%- macro _join(parts, sep=" - ") -%}
{{ parts | select | join(sep) }}
{%- endmacro -%}

{#- Powers ----------------------------------------------------------------- -#}

{%- macro power(p, class_name="", upgrades=True) -%}
<div class="Power">
<p class="Power-Title bar-{{ p.colour }}"><strong>{{ p.name }}{% if class_name %} - {{ class_name }}{% endif %}{% if p.is_feature %} Feature{% endif %}{% if p.level %} {{ p.level }}{% endif %}</strong></p>
<p>{{ _join([p.type, (p.usage_limit ~ " " ~ p.usage_number) | trim, p.keywords and "<i>" ~ p.keywords ~ "</i>"]) }}</p>
{%- set action = _join([
    p.action and "<b><i>" ~ p.action ~ "</i></b>",
    p.trigger and "<i>(Trigger: " ~ p.trigger ~ ")</i>",
    p.range and "<b>" ~ p.range ~ "</b>",
    p.target,
    p.attack_roll]) %}
{% if action %}<p>{{ action | nl2br }}</p>{% endif %}
{% if p.effect_pre %}<p><b>Effect</b>: {{ p.effect_pre | nl2br }}</p>{% endif %}
{% if p.hit %}<p><b>Hit</b>: {{ p.hit | nl2br }}</p>{% endif %}
{% if p.miss %}<p><b>Miss</b>: {{ p.miss | nl2br }}</p>{% endif %}
{% if p.effect_post %}<p><b>Effect</b>: {{ p.effect_post | nl2br }}</p>{% endif %}
{% if p.misc %}<p>{{ p.misc | nl2br }}</p>{% endif %}
{% if p.secondary_attack %}<p><b>Secondary Attack:</b> {{ p.secondary_attack | nl2br }}</p>{% endif %}
{% if upgrades and p.upgrades %}<p><span class="Power-Upgrade">{{ p.upgrades | nl2br }}</span></p>{% endif %}
</div>
{%- endmacro -%}

{%- macro power_list(powers, class_name="", upgrades=True) -%}
<div class="Power-List">
{% for p in powers %}{{ power(p, class_name(p) if class_name is callable else class_name, upgrades) }}
{% endfor -%}
</div>
{%- endmacro -%}

{#- Features and stats --------------------------------------------------------- -#}

{%- macro feature(f) -%}
<div class="Feature"><p><b>{{ f.name }}</b>: {{ f.description | nl2br }}</p></div>
{%- endmacro -%}

{%- macro feature_list(features, wrap=False) -%}
{% if wrap %}<div class="Feature-List">
{% endif %}
{%- for f in features %}{{ feature(f) }}
{% endfor -%}
{% if wrap %}</div>{% endif %}
{%- endmacro -%}

{%- macro stat_table(rows) -%}
<table class="Class-table">
<tbody>
{% for key, value in rows %}<tr><td>{{ key }}</td><td>{{ value | nl2br }}</td></tr>
{% endfor -%}
</tbody>
</table>
{%- endmacro -%}

{#- Generic tables ---------------------------------------------------------------- -#}

{%- macro table(rows, css_class="General-table", columns=None) -%}
{%- set columns = columns or (rows[0].keys() | list if rows else []) -%}
<table class="{{ css_class }}">
<thead><tr>{% for c in columns %}<th>{{ c }}</th>{% endfor %}</tr></thead>
<tbody>
{% for r in rows %}<tr>{% for c in columns %}<td>{{ r[c] | nl2br }}</td>{% endfor %}</tr>
{% endfor -%}
</tbody>
</table>
{%- endmacro -%}

{%- macro grouped_table(rows, columns, groups, css_class="General-table") -%}
{#- groups: list of (label, span) for a header row above the column names -#}
<table class="{{ css_class }}">
<thead>
<tr>{% for label, span in groups %}<th colspan="{{ span }}">{{ label }}</th>{% endfor %}</tr>
<tr>{% for c in columns %}<th>{{ c }}</th>{% endfor %}</tr>
</thead>
<tbody>
{% for r in rows %}<tr>{% for v in r %}<td>{{ v }}</td>{% endfor %}</tr>
{% endfor -%}
</tbody>
</table>
{%- endmacro -%}

{#- Feats ----------------------------------------------------------------------------- -#}

{%- macro feat(f) -%}
<div class="Feat">
<p class="blue large"><strong>{{ f.name }}</strong></p>
<p class="darkgray"><strong>{{ _join([f.category, f.level and "Level " ~ f.level]) }}</strong></p>
{% if f.keywords %}<p class="darkgray">Keywords: <em>{{ f.keywords }}</em></p>
{% endif %}
{%- if f.requirements %}<p class="gray"><em>Requires: {{ f.requirements }}</em></p>
{% endif -%}
<p>{{ f.text | nl2br }}</p>
</div>
{%- endmacro -%}

{%- macro feat_short(f) -%}
<div class="Feature"><strong>{{ f.name }}: </strong>{{ f.text | nl2br }}</div>
{%- endmacro -%}

{%- macro feat_list(feats, wrap=False, short=False) -%}
{% if wrap %}<div class="{{ 'Feature-List' if short else 'Feat-List' }}">
{% endif %}
{%- for f in feats %}{{ feat_short(f) if short else feat(f) }}
{% endfor -%}
{% if wrap %}</div>{% endif %}
{%- endmacro -%}

{#- Magic items ------------------------------------------------------------------------- -#}

{%- macro item(i) -%}
<div class="Power">
<p class="Power-Title bar-{{ i.colour }}"><strong>{{ i.name }}</strong><br>{{ i.rarity }} {{ i.type }} - {{ [i.level_h, i.level_p, i.level_e] | join("/") }}</p>
{% for prop in i.properties %}<p>{{ prop | nl2br | item_labels }}</p>
{% endfor -%}
</div>
{%- endmacro -%}

{%- macro item_list(items) -%}
<div class="Power-List">
{% for i in items %}{{ item(i) }}
{% endfor -%}
</div>
{%- endmacro -%}

{#- Monsters ------------------------------------------------------------------------------
    Race and class cards share a fixed-height name band and stats band, so when a race card
    sits left of a class card, the class's HP pointer lines up with the race's HP row. -#}

{%- macro _monster_items(title, pairs) -%}
{%- set pairs = pairs | selectattr(0) | list -%}
{%- if pairs %}
<div class="mc-sec">{{ title }}</div>
{% for name, text in pairs %}<div class="mc-item"><b>{{ name }}</b>{% if text %}<br>{{ text | nl2br }}{% endif %}</div>
{% endfor %}
{%- endif -%}
{%- endmacro -%}

{%- macro _stat_grid(m, keys, css) -%}
<div class="mc-grid {{ css }}">{% for k in keys %}<div><small>{{ k | upper }}</small>{{ m[k] }}</div>{% endfor %}</div>
{%- endmacro -%}

{%- macro monster_race(m) -%}
<div class="mc monster-race">
<div class="mc-head"><div><div class="mc-name">{{ m.Name }}</div><div class="mc-sub">{{ _join([m.Size, m.Type], " ") }}</div></div>
<div class="mc-badge"><small>LEVEL</small>{{ m.Level }}</div></div>
<div class="mc-band race">
{{ _stat_grid(m, ["Def", "H", "D", "E"], "g4") }}
<div class="mc-hp">{% for label, key in [("Hi", "HPHi"), ("Mid", "HPMid"), ("Low", "HPLow")] %}<div><span>{{ label }}</span><b>{{ m[key] }}</b></div>{% endfor %}</div>
</div>
<div class="mc-line"><b>Move</b> {{ m.Movement | replace("<br>", " &middot; ") | nl2br }}{% if m.Reach %} &middot; <b>Reach</b> {{ m.Reach }}{% endif %}</div>
{{ _stat_grid(m, ["Str", "Con", "Dex", "Wis", "Cha", "Int"], "g6") }}
{% if m.Resistances %}<div class="mc-line"><b>Resistances</b> {{ m.Resistances | nl2br }}</div>
{% endif %}
{{ _monster_items("Race Powers", [(m.RacePowerName, m.RacePower), (m.RacePowerName2, m.RacePower2), (m.RacePowerName3, m.RacePower3)]) }}
{{ _monster_items("Race Traits", [(m.RaceTraitName, m.RaceTrait), (m.RaceTraitName2, m.RaceTrait2)]) }}
{% if m.RaceSkills %}<div class="mc-foot"><b>Skills</b> {{ m.RaceSkills }}</div>
{% endif %}
</div>
{%- endmacro -%}

{%- macro monster_class(m) -%}
{%- set hp = m.HP.split() -%}
<div class="mc monster-class">
<div class="mc-head"><div><div class="mc-name">{{ m.Name }}</div><div class="mc-sub">{{ m.Role }}</div></div></div>
<div class="mc-band class">
<div class="mc-hp pointer">{% for label in ["Hi", "Mid", "Low"] %}<div class="{{ 'on' if label == hp[0] else 'off' }}"><span>{{ '&#9664;' if label == hp[0] }}</span><b>{{ label }}{% if label == hp[0] and hp | length > 1 %} {{ hp[1] }}{% endif %}</b></div>{% endfor %}</div>
{{ _stat_grid(m, ["Ar", "For", "Ref", "Will", "OA", "Init", "Mov"], "g7") }}
</div>
<div class="mc-sec">Attacks</div>
<div class="mc-item"><b>Melee Basic</b><br>{{ m.BasicAttack | nl2br }}</div>
<div class="mc-item"><b>Standard Attack</b><br>{{ m.StandardAttack | nl2br }}</div>
{{ _monster_items("Class Powers", [(m.ClassPowerName, m.ClassPower), (m.ClassPowerName2, m.ClassPower2), (m.ClassPowerName3, m.ClassPower3)]) }}
{{ _monster_items("Class Traits", [(m.ClassTraitName, m.ClassTrait), (m.ClassTraitName2, m.ClassTrait2), (m.ClassTraitName3, m.ClassTrait3)]) }}
{% if m.ClassSkills %}<div class="mc-foot"><b>Skills</b> {{ m.ClassSkills }}</div>
{% endif %}
</div>
{%- endmacro -%}

{%- macro monster_list(monsters, kind) -%}
<div class="monsterList">
{% for m in monsters %}{{ monster_race(m) if kind == "race" else monster_class(m) }}
{% endfor -%}
</div>
{%- endmacro -%}

{%- macro monster_pair(race, cls) -%}
<div class="monster-pair">
{{ monster_race(race) }}
{{ monster_class(cls) }}
</div>
{%- endmacro -%}
